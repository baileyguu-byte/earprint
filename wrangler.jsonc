{
  // Earprint: static files in public/ plus a small Worker (src/worker.js) for feedback and robots.txt.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earprint",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  // Branch builds get their own *-earprint.<account>.workers.dev link. Previews don't inherit
  // production bindings: they write feedback to a separate test database.
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "earprint-feedback-preview", "database_id": "d932c542-92cc-4493-8744-09438244367b" }
    ],
    "ratelimits": [
      { "name": "FEEDBACK_LIMIT", "namespace_id": "4202", "simple": { "limit": 3, "period": 60 } }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only these paths run the Worker; every other request is a static file, served directly.
    "run_worker_first": ["/api/*", "/robots.txt"]
  },
  // Feedback messages. Schema: migrations/0001_feedback.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "earprint-feedback", "database_id": "bb24e7d7-2f7e-4ba5-9a4f-8af70e51a30d" }
  ],
  // At most 3 feedback posts per minute from one IP address (counted by Cloudflare, not stored).
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "4201", "simple": { "limit": 3, "period": 60 } }
  ]
}
