{
  // Earprint is a static site served by a Cloudflare Worker with static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earprint",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  // Branch builds get their own *-earprint.<account>.workers.dev link.
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
